<?xml version="1.0" encoding="UTF-8"?>

<atlassian-plugin key="${atlassian.plugin.key}" name="${project.name}" plugins-version="2">
    <plugin-info>
        <description>${project.description}</description>
        <version>${project.version}</version>
        <vendor name="${project.organization.name}" url="${project.organization.url}"/>
        <param name="plugin-icon">images/pluginIcon.png</param>
        <param name="plugin-logo">images/pluginLogo.png</param>
    </plugin-info>
    <resource type="i18n" name="i18n" location="bookstore-plugin"/>
    <web-item key="bookstore-project-users-item"
              name="Project users"
              section="jira.project.sidebar.plugins.navigation"
              weight="10">
        <label key="bookstore.project.users.label">Project users</label>
        <link linkId="bookstore-project-users-link">
            /plugins/servlet/projectusersservlet?projectKey=$pathEncodedProjectKey
        </link>
    </web-item>
    <web-resource key="bookstore-plugin-resources" name="bookstore-plugin Web Resources">
        <dependency>com.atlassian.auiplugin:ajs</dependency>
        <resource type="download" name="bookstore-plugin.css" location="/css/bookstore-plugin.css"/>
        <resource type="download" name="bookstore-plugin.js" location="/js/bookstore-plugin.js"/>
        <resource type="download" name="images/" location="/images"/>
        <context>bookstore-plugin</context>
    </web-resource>
    <servlet name="Project Users Servlet" i18n-name-key="project-users-servlet.name" key="project-users-servlet"
             class="com.bookstore.jira.servlet.ProjectUsersServlet">
        <description key="project-users-servlet.description">The Project Users Servlet Plugin</description>
        <url-pattern>/projectusersservlet</url-pattern>
    </servlet>
    <resource type="velocity" name="project-users-view"
              location="templates/project-users.vm"/>
</atlassian-plugin>
